# Copy to .env and fill in. Never commit .env (docs/devenv.md §4, NFR-SEC-02).

ANTHROPIC_API_KEY=sk-ant-...
DATABASE_URL=postgresql+psycopg://specforge:specforge@localhost:5432/specforge

# Only needed if omc / the SysML toolchain aren't already on PATH (docs/devenv.md §2-3).
OPENMODELICA_HOME=
SYSML_TOOL_CMD=
